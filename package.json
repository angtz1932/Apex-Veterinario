{
  "name": "apex-veterinario-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm --prefix apps/web run build",
    "build:web": "npm --prefix apps/web run build",
    "build:api": "npm --prefix apps/api run build",
    "dev:api": "cd apps/api && npm run start:dev",
    "dev:web": "cd apps/web && npm run dev",
    "start:web": "cd apps/web && npm run dev",
    "start:api": "cd apps/api && npm run start:dev"
  }
}
